    <texto id="t3">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Por su alta capacidad de magnetización, el imán de la máquina debe mantenerse a una distancia de seguridad mínima evitando así que los elementos paramagnéticos sean atraídos y resulten peligrosos.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Por estas razones es importante <FONT COLOR="#384858"><B>controlar los objetos que acceden a la sala y elaborar un cuestionario de elementos prohibidos</B></FONT> para el paciente o el personal sanitario que acceda al interior de la misma.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,132</pos>
      <size>384,260</size>
    </texto>
    <texto id="t1">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Seguridad en RM</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,16</pos>
