    <texto id="instance46">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0">Cada órgano o sistema del organismo<FONT COLOR="#333333"> <FONT COLOR="#384858"><B>requiere un estudio concreto</B></FONT>, ajustando no solo el área anatómica a explorar sino ajustando una serie de parámetros del equipo de resonancia.</FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
