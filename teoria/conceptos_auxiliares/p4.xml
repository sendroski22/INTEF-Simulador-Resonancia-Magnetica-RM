    </texto>
    <texto id="instance77">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Los contrastes s<FONT COLOR="#666666">on sustancias químicas</FONT> que presentan una afinidad por diversas estructuras o tejidos de tal manera que pueden emplearse tanto para resaltar determinadas áreas anatómicas (vasos sanguíneos) como para evidenciar áreas con mayor realce o señal en RM (infecciones, inflamaciones, neoplasias).</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,1734</pos>
      <size>360,195</size>
    </texto>
    <texto id="instance78">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Una de las sustancias más comunes es el Gadolinio (Gd).</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
