      <size>714,88</size>
    </texto>
    <texto id="instance47">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0">Cada conjunto de parámetros<FONT COLOR="#333333"> puede predefinirse en un <FONT COLOR="#384858"><B>programa específico para acelerar el proceso</B></FONT> y definirse con un término concreto denominado protocolo.</FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
