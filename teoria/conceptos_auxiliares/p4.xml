    <texto id="instance76">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Uso de contrastes:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,1703</pos>
