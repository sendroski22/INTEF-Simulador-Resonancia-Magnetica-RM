      <pos>45,2014</pos>
      <size>739,27</size>
    </texto>
    <texto id="instance83">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Es muy importante un <FONT COLOR="#666666">ajuste periódico del mismo según indicaciones del fabricante</FONT>.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2045</pos>
      <size>360,66</size>
    </texto>
    <texto id="instance86">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Es imprescindible <FONT COLOR="#999999">mantener las normas estrictamente acerca del material que puede introducirse en la sala de RM</FONT>.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2112</pos>
      <size>360,88</size>
    </texto>
    <texto id="instance88">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Antes de comenzar el estudio debemos <FONT COLOR="#666666">asegurarnos de la presencia de todo el material necesario</FONT>: sacos, vendas fijadoras, antenas, vías venosas, sueros y botellas de contraste.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2200</pos>
      <size>360,131</size>
    </texto>
    <texto id="instance90">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Se deberá <FONT COLOR="#666666">encender el equipo y software con suficientemente tiempo</FONT> antes del comienzo de la sesión de RM.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2331</pos>
      <size>360,88</size>
    </texto>
    <texto id="instance92">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Es imprescindible <FONT COLOR="#666666">mantener limpia y recogida la sala de RM</FONT>.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2418</pos>
      <size>360,66</size>
    </texto>
    <texto id="instance97">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Operaciones de centraje:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,2551</pos>
      <size>739,27</size>
    </texto>
    <texto id="instance98">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0">Situar al enfermo sobre la mesa de estudio<FONT COLOR="#333333"> en una posición adecuada.</FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2578</pos>
      <size>713,45</size>
    </texto>
    <texto id="instance100">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Se puede <FONT COLOR="#666666">desplazar la mesa con el enfermo hasta situar centrarlo bajo el imán</FONT>, ya sea manualmente o preprogramado. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2623</pos>
      <size>713,66</size>
    </texto>
    <texto id="instance104">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Planificación y exploración de imágenes en el monitor:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,2710</pos>
      <size>739,27</size>
    </texto>
    <texto id="instance105">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">La imagen obtenida en RM debe ser <FONT COLOR="#666666">interpretada por el médico radiólogo</FONT> asignado.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2737</pos>
      <size>358,88</size>
    </texto>
    <texto id="instance107">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0">Se le entregarán los estudios con las secuencias específicas<FONT COLOR="#333333"> y en los planos indicados en el volante. </FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,2825</pos>
      <size>358,88</size>
    </texto>
    <texto id="instance112">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Selección de las imágenes más significativas que deben ser impresionadas en película radiográfica o enviadas a radiografía:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,3020</pos>
      <size>739,53</size>
    </texto>
    <texto id="instance113">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Las imágenes adquiridas <FONT COLOR="#666666">deben almacenarse en un sistema de archivo</FONT>.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3077</pos>
      <size>714,45</size>
    </texto>
    <texto id="instance115">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Es preciso que el técnico r<FONT COLOR="#666666">evise las imágenes recogidas y valore la calidad</FONT> de las mismas.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3122</pos>
      <size>714,66</size>
    </texto>
    <texto id="instance117">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Es posible que se hayan <FONT COLOR="#666666">producido artefactos de movimiento del paciente</FONT>, se hayan interpuesto estructuras, etc.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3189</pos>
      <size>714,66</size>
    </texto>
    <texto id="instance121">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Detección de artefacto y control de calidad de una imagen:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,3272</pos>
      <size>739,27</size>
    </texto>
    <texto id="instance122">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Se define como artefacto a <FONT COLOR="#666666">cualquier alteración en la imagen adquirida</FONT>, que no se corresponde con una estructura anatómica real.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3299</pos>
      <size>359,109</size>
    </texto>
    <texto id="instance124">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Uno de los posibles artefactos más habituales es el producido por los <FONT COLOR="#666666">movimientos respiratorios o latidos cardiacos del paciente</FONT>.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3408</pos>
      <size>359,109</size>
    </texto>
    <texto id="instance127">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Otro de los artefactos son los <FONT COLOR="#666666">producidos por partículas metálicas dentro del paciente</FONT> como prótesis articulares.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3517</pos>
      <size>359,88</size>
    </texto>
    <texto id="instance131">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Seguridad en RMN:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,3623</pos>
      <size>739,27</size>
    </texto>
    <texto id="instance132">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Es muy importante <FONT COLOR="#666666">seguir unas pautas de actuación dentro de la sala de RM</FONT> dado la complejidad del equipo y sus características específicas.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3650</pos>
      <size>359,109</size>
    </texto>
    <texto id="instance134">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0">Se debe ser estricto con los objetos que accedan a la sala <FONT COLOR="#333333">y elaborar un cuestionario de elementos prohibidos para el paciente o el personal sanitario que acceda al interior.</FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#666666" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3759</pos>
      <size>359,109</size>
    </texto>
    <texto id="instance137">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Posibles <FONT COLOR="#666666">riesgos de electrocución</FONT> pues es un equipo basado en campos electromagnéticos.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3868</pos>
      <size>359,88</size>
    </texto>
    <texto id="instance139">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Precaución con <FONT COLOR="#666666">el sistema de salida de gases de refrigeración</FONT> y controlar que la temperatura del equipo permanezca dentro de un rango determinado. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,3956</pos>
      <size>714,66</size>
    </texto>
