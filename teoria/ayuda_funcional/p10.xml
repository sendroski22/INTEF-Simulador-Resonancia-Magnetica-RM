      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">&quot;Estado de crisis&quot;</FONT></P></TEXTFORMAT>]]></html_data>
