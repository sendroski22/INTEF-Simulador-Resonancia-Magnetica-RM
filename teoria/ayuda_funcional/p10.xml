    <texto id="t2">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">A lo largo de la simulación tus decisiones pueden llevarte a un <FONT COLOR="#384858"><B>estado de crisis</B></FONT>. Estos estados vienen producidos por <FONT COLOR="#384858"><B>cosas que has hecho mal</B></FONT> a lo largo de la simulación, y que, al igual que en la vida real, tienen consecuencias graves. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,48</pos>
      <size>734,88</size>
    </texto>
    <texto id="t3">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Una vez que se ha producido una crisis, tendrás que tomar <FONT COLOR="#384858"><B>decisiones rápidas y acertadas</B></FONT> para tratar de solucionar el problema, perjudicando lo menos posible a todos los que te rodean. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#384858" LETTERSPACING="0" KERNING="0"><B>Evita estas situaciones</B><FONT COLOR="#333333"> en la medida de lo posible.<FONT COLOR="#384858"></FONT></FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#384858" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
