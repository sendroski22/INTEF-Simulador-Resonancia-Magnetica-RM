    <texto id="t2">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Durante toda la simulación tendrás disponible un pequeño <FONT COLOR="#384858"><B>menú en la parte superior de la pantalla</B></FONT>. El objeto de este menú es ayudarte y hacerte la &quot;vida&quot; más sencilla. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
