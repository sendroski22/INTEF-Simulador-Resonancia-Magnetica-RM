    </texto>
    <texto id="t2">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">El protagonista del juego <FONT COLOR="#384858"><B>eres tú</B></FONT> dentro de poco tiempo, enfrentándote a un día cualquiera de trabajo. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Disfruta de lo que será tu futuro, sin miedo a hacer las cosas mal. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,48</pos>
      <size>737,109</size>
    </texto>
    <texto id="t3">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Aprende todo lo que el simulador te puede ofrecer y enfréntate a situaciones difíciles y reales.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Durante toda la simulación <FONT COLOR="#384858"><B>podrás &quot;oír&quot; todo lo que tu &quot;Yo virtual&quot; piensa</B></FONT>, a modo de ayuda referente al entorno en el que vive. Un entorno que tú todavía no conoces. ¿Parece complicado? No lo es. Actúa como si fuera <FONT COLOR="#384858"><B>tu primer día de trabajo</B></FONT>, y todo saldrá bien.</FONT></P></TEXTFORMAT>]]></html_data>
