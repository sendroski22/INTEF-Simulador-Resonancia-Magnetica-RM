    </texto>
    <texto id="instance70">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">La trazabilidad y persistencia se realiza mediante <FONT COLOR="#384858"><B>SCORM</B></FONT> y se almacena en el LMS, estando así disponible siempre junto al LMS.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>78,3679</pos>
      <size>695,66</size>
    </texto>
    <texto id="instance71">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Permite <FONT COLOR="#384858"><B>guardar la sesión en curso y posibilita cargarla posteriormente</B></FONT> (estará disponible siempre junto al LMS).</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>78,3745</pos>
