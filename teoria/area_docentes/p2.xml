    <texto id="instance65">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#384858" LETTERSPACING="0" KERNING="0"><B>Cada caso del simulador se traduce a un objetivo del ODE</B><FONT COLOR="#333333">, completándose todo el simulador cuando se realizan todos los casos.<FONT COLOR="#384858"></FONT></FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#384858" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>78,3811</pos>
      <size>695,66</size>
