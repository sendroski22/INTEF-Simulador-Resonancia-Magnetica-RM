  <textos>
    <texto id="instance7">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">En el modo <FONT COLOR="#384858"><B>normal</B></FONT>, que es el que aparece por defecto, tienes <FONT COLOR="#384858"><B>100</B></FONT> puntos. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,4162</pos>
      <size>356,66</size>
    </texto>
    <texto id="instance9">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">En el <FONT COLOR="#384858"><B>difícil</B></FONT> sólo empiezas con <FONT COLOR="#384858"><B>75</B></FONT>. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,4228</pos>
      <size>356,45</size>
    </texto>
    <texto id="instance10">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">La dificultad establece el número de errores que pueden cometerse.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">En el modo difícil hay que estar muy atento, y tener claro los procesos a seguir. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>43,4273</pos>
      <size>386,131</size>
    </texto>
    <texto id="instance11">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">En el panel de administración tienes una opción llamada <FONT COLOR="#384858"><B>&quot;Dificultad&quot;</B></FONT>. Si pinchas sobre ella, podrás establecer la dificultad que quieres para el simulador. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Hay tres niveles: <FONT COLOR="#384858"><B>Fácil, normal y difícil</B></FONT>. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">La diferencia entre ellos reside en la puntuación de <FONT COLOR="#384858"><B>PT y PI</B></FONT> con la que empiezas. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,3944</pos>
      <size>740,152</size>
    </texto>
    <texto id="instance12">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0"> ¿Puedo configurar el simulador?:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,3185</pos>
      <size>551,27</size>
    </texto>
    <texto id="instance13">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Definitivamente sí. Integrada en la simulación hay un <FONT COLOR="#384858"><B>acceso al panel de control del simulador</B></FONT>. En la primera sala, dirígete al <FONT COLOR="#384858"><B>cuadro de electricidad</B></FONT> y pincha sobre el mismo. Así accedes al cuadro de configuración del profesor. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Desde este panel, puedes <FONT COLOR="#384858"><B>controlar los volantes sobre los que se puede trabajar</B></FONT>. Podrás seleccionar el grado de dificultad de la simulación e incluso podrás personalizar el estado de los pacientes. Desde este lugar también podrás <FONT COLOR="#384858"><B>acceder a una guía de cómo utilizar el simulador</B></FONT> en las clases y cómo sacarle el máximo partido.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>45,3222</pos>
      <size>355,367</size>
    </texto>
    <texto id="instance14">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">¿Cómo puedo controlar los conflictos sobre los que trabajar?:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,3589</pos>
      <size>741,27</size>
    </texto>
    <texto id="instance15">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Una vez que estés en el panel de administración verás, que hay una opción llamada <FONT COLOR="#384858"><B>&quot;Configurar volantes&quot;</B></FONT>. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Si pinchas sobre ella podrás seleccionar <FONT COLOR="#384858"><B>que volantes quieres que permanezcan activos</B></FONT>, y cuales quieres que estén desactivados durante la sesión. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Si por ejemplo quieres que solo haya un volante disponible, tendrás que desactivar el resto. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>399,3626</pos>
      <size>385,281</size>
    </texto>
    <texto id="instance16">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">En el modo <FONT COLOR="#384858"><B>fácil</B></FONT> comienzas con <FONT COLOR="#384858"><B>150</B></FONT> puntos en ambos valores. </FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>71,4096</pos>
      <size>356,66</size>
    </texto>
    <texto id="instance19">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">¿Puedo consultar las sesiones de usuarios?:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,4404</pos>
      <size>739,27</size>
    </texto>
    <texto id="instance20">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Uno de los objetivos clave de este simulador es que puedas <FONT COLOR="#384858"><B>consultar las distintas sesiones de los alumnos y los informes finales</B></FONT> que se crean cuando terminan las simulaciones. De este modo podrás saber en que han fallado, que conocimientos no controlan… todo ello para que puedas repasarlo en clase e incidir sobre estos aspectos en tus explicaciones.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>425,4441</pos>
      <size>359,346</size>
    </texto>
    <texto id="instance23">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">¿Puedo seleccionar el grado de dificultad del simulador?</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,3907</pos>
      <size>739,27</size>
    </texto>
    <texto id="instance26">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Destinatarios:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,351</pos>
      <size>551,27</size>
    </texto>
    <texto id="instance27">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Válido para la formación de técnicos superiores en imagen para el diagnóstico, radioterapia, diplomaturas universitarias de enfermería, fisioterapia y estudios universitarios pregrado de medicina y ciencias de la salud.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,388</pos>
      <size>727,88</size>
    </texto>
    <texto id="instance33">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Temporización del simulador:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>42,2804</pos>
      <size>551,27</size>
    </texto>
    <texto id="instance34">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">El <FONT COLOR="#384858"><B>tiempo de simulación para la resolución de un caso</B></FONT> es de, aproximadamente, <FONT COLOR="#384858"><B>30 minutos</B></FONT>.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>78,2841</pos>
      <size>695,66</size>
    </texto>
    <texto id="instance35">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">El tiempo de <FONT COLOR="#384858"><B>simulación total</B></FONT>, es decir, para la realización de todos los casos propuestos es de, aproximadamente, <FONT COLOR="#384858"><B>30 horas.</B></FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>78,2907</pos>
      <size>695,66</size>
    </texto>
    <texto id="instance36">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">El tiempo estimado para la <FONT COLOR="#384858"><B>consulta de los apartados teóricos</B></FONT> (glosario, teoría y conceptos auxiliares) es de, aproximadamente, <FONT COLOR="#384858"><B>20 horas.</B></FONT></FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>78,2973</pos>
      <size>695,66</size>
    </texto>
    <texto id="instance39">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Cómo empiezo:</FONT></P></TEXTFORMAT>]]></html_data>
      <pos>42,3038</pos>
      <size>732,27</size>
    </texto>
    <texto id="instance40">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Primero debes familiarizarte con el simulador. <FONT COLOR="#384858"><B>Pruébalo</B></FONT> y disfruta del mundo que te ofrece. Cuando ya tengas claro cómo funciona, prueba a <FONT COLOR="#384858"><B>cambiar las distintas configuraciones desde el panel de administración</B></FONT> y mira cómo afectan a la sesión. ¿Ya lo has hecho? Es el momento de presentar el simulador a tus alumnos.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>44,3075</pos>
      <size>733,109</size>
    </texto>
    <texto id="instance41">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Identificar en imágenes multiplanares de RM.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>75,512</pos>
      <size>706,45</size>
    </texto>
    <texto id="instance42">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Reconocer, nombrar y posicionar, identificando lateralidad, las articulaciones y huesos que conforman: extremidad superior, extremidad inferior, caja torácica, columna vertebral, cráneo y cara.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>75,558</pos>
      <size>707,88</size>
    </texto>
    <texto id="instance43">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Reconocer, nombrar y posicionar, identificando lateralidad, los órganos y estructuras que se encuentran en: cavidad torácica, cavidad abdominal, cavidad pélvica, médula espinal y mama.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>75,646</pos>
      <size>356,131</size>
    </texto>
    <texto id="instance44">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Objetivos generales de la ficha de diseño instructivo: </FONT></P></TEXTFORMAT>]]></html_data>
      <pos>41,476</pos>
      <size>729,27</size>
    </texto>
    <texto id="instance45">
