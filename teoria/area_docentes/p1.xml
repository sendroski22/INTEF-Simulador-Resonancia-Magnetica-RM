      <pos>75,924</pos>
      <size>707,45</size>
    </texto>
    <texto id="instance46">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Trebuchet MS" SIZE="20" COLOR="#0066FF" LETTERSPACING="0" KERNING="0">Objetivos especificos de la ficha de diseño instructivo: </FONT></P></TEXTFORMAT>]]></html_data>
      <pos>41,888</pos>
      <size>729,27</size>
    </texto>
    <texto id="instance47">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Comprender las relaciones existentes entre los sistemas y aparatos que componen las estructuras anatómicas del cuerpo humano.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>85,970</pos>
      <size>697,66</size>
    </texto>
    <texto id="instance48">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Relacionar las estructuras anatómicas del cuerpo humano que intervienen en el movimiento y la actitud postural con la función locomotriz y postural.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>85,1036</pos>
      <size>699,66</size>
    </texto>
    <texto id="instance51">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#384858" LETTERSPACING="0" KERNING="0"><B>De carácter procedimental:</B></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>75,1560</pos>
      <size>707,45</size>
    </texto>
    <texto id="instance52">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Poseer una visión de conjunto de los diferentes procesos de registros gráficos con equipos de procesamiento informático de imágenes de RM, para la obtención de imágenes para el diagnóstico.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>84,1605</pos>
      <size>328,152</size>
    </texto>
    <texto id="instance53">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Comprender las operaciones de centraje, planificación y exploración realizadas para los diferentes territorios anatómicos.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>84,1757</pos>
      <size>345,88</size>
    </texto>
    <texto id="instance54">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Aplicar los conocimientos de imagen de RM en los procedimientos de simulación y de planificación de tratamientos en Radioterapia.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>85,1845</pos>
      <size>698,66</size>
    </texto>
    <texto id="instance55">
      <html_data><![CDATA[<TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0">Relacionar imágenes de RM con proyecciones y posiciones del paciente en simuladores de Radioterapia.</FONT></P></TEXTFORMAT><TEXTFORMAT LEADING="2"><P ALIGN="LEFT"><FONT FACE="Verdana" SIZE="16" COLOR="#333333" LETTERSPACING="0" KERNING="0"></FONT></P></TEXTFORMAT>]]></html_data>
      <pos>85,1911</pos>
      <size>699,66</size>
    </texto>
